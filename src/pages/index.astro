---
import Layout from '../layouts/Layout.astro';

import Resume from '../sections/resume/Resume.astro';
import Experience from '../sections/experience/Experience.astro';
import Project from '../sections/project/Project.astro';
import About from '../sections/about/About.astro';

import SectionContainer from '../components/SectionContainer.astro';

import GitMergeIcon from '../icons/GitMergeIcon.astro';
import CodeIcon from '../icons/CodeIcon.astro';
import PersonIcon from '../icons/PersonIcon.astro';

// Default to English - language will be managed client-side
const lang = 'en' as 'en' | 'es';
---

<Layout
  title="Brando Vidal - AWS Developer Associate | Fullstack Developer"
  description="Contacta conmigo para desarrollar tu idea."
>
  <main>
    <SectionContainer id="resume">
      <Resume lang={lang} />
    </SectionContainer>

    <SectionContainer id="experience">
      <div class="space-y-8">
        <h2 class="flex gap-x-3 text-3xl font-bold animate-fade-in-up">
          <GitMergeIcon />
          <span data-i18n-experience-title>{lang === 'es' ? 'Experiencia' : 'Experience'}</span>
        </h2>
        <Experience {lang} />
      </div>
    </SectionContainer>

    <SectionContainer id="projects">
      <div class="space-y-8">
        <h2 class="flex gap-x-3 text-3xl font-bold animate-fade-in-up">
          <CodeIcon />
          <span data-i18n-projects-title>{lang === 'es' ? 'Proyectos' : 'Projects'}</span>
        </h2>
        <Project {lang} />
      </div>
    </SectionContainer>

    <SectionContainer id="about-me">
      <div class="space-y-8">
        <h2 class="flex gap-x-3 text-3xl font-bold animate-fade-in-up">
          <PersonIcon />
          <span data-i18n-about-title>{lang === 'es' ? 'Sobre mí' : 'About'}</span>
        </h2>
        <About {lang} />
      </div>
    </SectionContainer>
  </main>
</Layout>
