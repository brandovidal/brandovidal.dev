---
import Layout from "../layouts/Layout.astro";

import Resume from "../sections/resume/Resume.astro";
import Experience from "../sections/experience/Experience.astro";
import Project from "../sections/project/Project.astro";
import About from "../sections/about/About.astro";

import SectionContainer from "../components/SectionContainer.astro";

import GitMergeIcon from "../icons/GitMergeIcon.astro";
import CodeIcon from "../icons/CodeIcon.astro";
import PersonIcon from "../icons/PersonIcon.astro";
---

<Layout
  title="Brando Vidal - AWS Developer Associate | Fullstack Developer"
  description="Contacta conmigo para desarrollar tu idea."
>
  <main>
    <SectionContainer id="resume">
      <Resume />
    </SectionContainer>

    <SectionContainer id="experience">
      <div class="space-y-8">
        <h2 class="flex gap-x-3 text-3xl font-bold">
          <GitMergeIcon />
          <span>Experience</span>
        </h2>
        <Experience />
      </div>
    </SectionContainer>

    <SectionContainer id="projects">
      <div class="space-y-8">
        <h2 class="flex gap-x-3 text-3xl font-bold">
          <CodeIcon />
          <span>Projects</span>
        </h2>
        <Project />
      </div>
    </SectionContainer>

    <SectionContainer id="about-me">
      <div class="space-y-8">
        <h2 class="flex gap-x-3 text-3xl font-bold">
          <PersonIcon />
          <span>About</span>
        </h2>
        <About />
      </div>
    </SectionContainer>
  </main>
</Layout>
