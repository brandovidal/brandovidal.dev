---
import TerminalBlock from "../../components/TerminalBlock.astro";
import SocialPill from "../../components/SocialPill.astro";

import LinkedinIcon from "../../icons/LinkedinIcon.astro";
import GithubIcon from "../../icons/GithubIcon.astro";
import FilePdfIcon from "../../icons/FilePdfIcon.astro";

const SOCIAL_MEDIAS = [
  {
    name: "Linkedin",
    href: "https://www.linkedin.com/in/brandovidal",
    icon: LinkedinIcon,
  },
  {
    name: "Github",
    href: "https://github.com/brandovidal",
    icon: GithubIcon,
  },
  {
    name: "Resumen",
    href: "https://pub-f58ba5761f03439babd2963d9a9fe027.r2.dev/BrandoVidalCV.pdf",
    icon: FilePdfIcon,
  },
];
---

<div class="space-y-6">
  <TerminalBlock
    name="Brando Vidal"
    role="AWS Developer Associate | Fullstack Developer"
    experience="+5 años de experiencia"
    availability="available"
  />

  <div class="space-y-3">
    <p class="text-gray-400 text-base leading-relaxed">
      Especializado en crear aplicaciones escalables y novedosas. Full-stack fluency across frontend, backend, cloud, and data layers.
    </p>
    <nav class="flex flex-wrap gap-3">
      {
        SOCIAL_MEDIAS.map(({ name, href, icon: Icon }) => (
          <SocialPill href={href}>
            <Icon class="size-4 lg:size-6" />
            {name}
          </SocialPill>
        ))
      }
    </nav>
  </div>
</div>
