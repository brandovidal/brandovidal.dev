---
import ExperienceItem from "./ExperienceItem.astro";
import { useTranslations } from "../../i18n/translations";
import type { Language } from "../../stores/langStore";

interface Props {
  lang?: Language;
}

interface ExperienceItemData {
  title: string;
  description: string;
  descriptionKey: string;
  company: string;
  date: string;
  dateKey: string;
  link?: string;
  layers: ("frontend" | "backend" | "cloud" | "data")[];
  technologies: string[];
}

const { lang = "en" } = Astro.props;
const translation = useTranslations(lang);

const EXPERIENCES: ExperienceItemData[] = [
  {
    title: "Backend Engineer",
    description: translation.experience.items.softtek.description,
    descriptionKey: "experience.items.softtek.description",
    company: "Softtek",
    date: translation.experience.items.softtek.date,
    dateKey: "experience.items.softtek.date",
    link: "https://softtek.com/",
    layers: ["backend", "cloud", "data"],
    technologies: [
      "Node.js",
      "TypeScript",
      "NestJS",
      "AWS",
      "DynamoDB",
      "Python",
    ],
  },
  {
    title: "Frontend Engineer",
    description: translation.experience.items.yape.description,
    descriptionKey: "experience.items.yape.description",
    company: "Yape",
    date: translation.experience.items.yape.date,
    dateKey: "experience.items.yape.date",
    link: "https://yape.com.pe/",
    layers: ["frontend", "backend"],
    technologies: ["React", "TypeScript", "Node.js", "Microservices"],
  },
  {
    title: "Fullstack Engineer",
    company: "Samishop",
    description: translation.experience.items.samishop.description,
    descriptionKey: "experience.items.samishop.description",
    date: translation.experience.items.samishop.date,
    dateKey: "experience.items.samishop.date",
    layers: ["frontend", "backend", "data"],
    technologies: ["React", "Node.js", "NestJS", "MongoDB", "React"],
  },
  {
    title: "Data Analyst Engineer",
    company: "Attach Media",
    description: translation.experience.items.attachMedia.description,
    descriptionKey: "experience.items.attachMedia.description",
    date: translation.experience.items.attachMedia.date,
    dateKey: "experience.items.attachMedia.date",
    link: "https://attachmedia.com/",
    layers: ["data", "backend"],
    technologies: ["SQL", "Python", "Analytics", "ETL"],
  },
  {
    title: "Fullstack Engineer",
    company: "Repuestock",
    description: translation.experience.items.repuestock.description,
    descriptionKey: "experience.items.repuestock.description",
    date: translation.experience.items.repuestock.date,
    dateKey: "experience.items.repuestock.date",
    link: "https://repuestock.com/",
    layers: ["frontend", "backend", "data"],
    technologies: ["React", "Node.js", "MongoDB", "AWS"],
  },
];
---

<div class="space-y-8">
  {
    EXPERIENCES.map(
      (
        {
          title,
          company,
          description,
          descriptionKey,
          date,
          dateKey,
          link,
          layers,
          technologies,
        },
        i,
      ) => (
        <ExperienceItem
          title={title}
          company={company}
          description={description}
          descriptionKey={descriptionKey}
          date={date}
          dateKey={dateKey}
          link={link}
          layers={layers}
          technologies={technologies}
          index={i}
        />
      ),
    )
  }
</div>
