---
import FlowIndicator from "../../components/FlowIndicator.astro";
import LayerBadge from "../../components/LayerBadge.astro";

interface Props {
  title: string;
  company: string;
  description: string;
  descriptionKey?: string;
  date: string;
  dateKey?: string;
  link?: string;
  layers: ('frontend' | 'backend' | 'cloud' | 'data')[];
  technologies: string[];
}
const { title, company, description, descriptionKey, date, dateKey, link, layers, technologies } = Astro.props;
---

<article class="border border-white/10 rounded-lg bg-white/[0.02] backdrop-blur-sm p-6 hover:border-white/20 hover:bg-white/[0.04] transition-all duration-300">
  <div class="flex flex-col gap-4">
    {/* Date and title */}
    <div>
      <time class="text-xs font-mono text-gray-500 uppercase tracking-wider" data-i18n-key={dateKey}>{date}</time>
      <h3 class="text-xl font-semibold text-white mt-2">{title}</h3>
      <a
        href={link || '#'}
        class="text-base font-medium text-gray-400 hover:text-white transition-colors inline-block"
        target={link ? '_blank' : undefined}
        rel={link ? 'noopener noreferrer' : undefined}
      >
        {company}
      </a>
    </div>

    {/* Flow indicators */}
    <div class="flex flex-wrap gap-2">
      <FlowIndicator layers={layers} />
    </div>

    {/* Description */}
    <p class="text-sm text-gray-400 leading-relaxed text-pretty" data-i18n-key={descriptionKey}>
      {description}
    </p>

    {/* Technologies by layer */}
    <div class="flex flex-wrap gap-2 pt-2">
      {
        technologies.map((tech) => {
          let layer: 'frontend' | 'backend' | 'cloud' | 'data' = 'backend';
          if (
            ['React', 'Vue', 'Angular', 'TypeScript', 'CSS', 'HTML', 'Astro', 'Next.js'].includes(tech)
          ) {
            layer = 'frontend';
          } else if (['Node.js', 'Express', 'Python', 'Django', 'FastAPI'].includes(tech)) {
            layer = 'backend';
          } else if (['AWS', 'Lambda', 'Serverless', 'Microservices'].includes(tech)) {
            layer = 'cloud';
          } else if (['PostgreSQL', 'MongoDB', 'DynamoDB', 'SQL', 'Analytics', 'ETL'].includes(tech)) {
            layer = 'data';
          }
          return <LayerBadge name={tech} layer={layer} />;
        })
      }
    </div>
  </div>
</article>
