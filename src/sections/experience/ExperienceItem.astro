---
import Card from "../../components/Card.astro";
import FlowIndicator from "../../components/FlowIndicator.astro";
import LayerBadge from "../../components/LayerBadge.astro";

interface Props {
  title: string;
  company: string;
  description: string;
  descriptionKey?: string;
  date: string;
  dateKey?: string;
  link?: string;
  layers: ("frontend" | "backend" | "cloud" | "data")[];
  technologies: string[];
  index?: number;
}
const {
  title,
  company,
  description,
  descriptionKey,
  date,
  dateKey,
  link,
  layers,
  technologies,
  index = 0,
} = Astro.props;

const primaryLayer = layers[0] ?? 'frontend';
const layerAccentClass: Record<string, string> = {
  frontend: 'border-l-2 border-l-blue-500/60',
  backend: 'border-l-2 border-l-emerald-500/60',
  cloud: 'border-l-2 border-l-amber-500/60',
  data: 'border-l-2 border-l-purple-500/60',
};
const accentClass = layerAccentClass[primaryLayer] ?? layerAccentClass.frontend;
---

<div data-reveal style={`transition-delay: ${index * 80}ms`}>
<Card
  class={`p-6 ${accentClass}`}
>
  <article class="flex flex-col gap-4">
    {/* Date and title */}
    <div>
      <time
        class="text-xs font-mono text-gray-500 uppercase tracking-wider"
        data-i18n-key={dateKey}>{date}</time
      >
      <h3 class="text-xl font-semibold text-white mt-2">{title}</h3>
      <a
        href={link || "#"}
        class="text-base font-medium text-gray-400 hover:text-white transition-colors inline-block"
        target={link ? "_blank" : undefined}
        rel={link ? "noopener noreferrer" : undefined}
      >
        {company}
      </a>
    </div>

    {/* Flow indicators */}
    <div class="flex flex-wrap gap-2">
      <FlowIndicator layers={layers} />
    </div>

    {/* Description */}
    <p
      class="text-sm text-gray-400 leading-relaxed text-pretty"
      data-i18n-key={descriptionKey}
    >
      {description}
    </p>

    {/* Technologies by layer */}
    <div class="flex flex-wrap gap-2 pt-2">
      {
        technologies.map((tech) => {
          let layer: "frontend" | "backend" | "cloud" | "data" | "tool" =
            "frontend";
          if (
            [
              "React",
              "Vue",
              "Angular",
              "Tailwind CSS",
              "CSS",
              "HTML",
              "Astro",
              "Next.js",
            ].includes(tech)
          ) {
            layer = "frontend";
          } else if (
            [
              "Node.js",
              "NestJS",
              "Express",
              "Python",
              "Kotlin",
              "SpringBoot",
              "FastAPI",
            ].includes(tech)
          ) {
            layer = "backend";
          } else if (
            [
              "AWS",
              "GCP",
              "Azure",
              "Lambda",
              "Serverless",
              "Microservices",
              "Github Actions",
            ].includes(tech)
          ) {
            layer = "cloud";
          } else if (
            [
              "PostgreSQL",
              "MongoDB",
              "DynamoDB",
              "MySQL",
              "Redis",
              "SQL",
              "Analytics",
              "ETL",
            ].includes(tech)
          ) {
            layer = "data";
          } else {
            layer = "tool";
          }
          return <LayerBadge name={tech} layer={layer} />;
        })
      }
    </div>
  </article>
</Card>
</div>
