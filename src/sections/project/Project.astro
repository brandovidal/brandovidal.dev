---
import SocialPill from "../../components/SocialPill.astro";
import LayerBadge from "../../components/LayerBadge.astro";

import GithubIcon from "../../icons/GithubIcon.astro";
import LinkIcon from "../../icons/LinkIcon.astro";

interface ArchitectureLayer {
  name: string;
  layer: 'frontend' | 'backend' | 'cloud' | 'data';
  tech: string[];
}

interface ProjectItem {
  name: string;
  description: string;
  url: string;
  githubUrl: string;
  imageUrl: string;
  architecture: {
    layers: ArchitectureLayer[];
  };
}

const PROJECTS: ProjectItem[] = [
  {
    name: "Bittyurl",
    description:
      "Free URL shortener. Built with modern technologies for speed and simplicity.",
    url: "https://bittyurl.netlify.app/",
    githubUrl: "https://github.com/brandovidal/bittyurl",
    imageUrl: "/projects/bittyurl.webp",
    architecture: {
      layers: [
        {
          name: "UI Layer",
          layer: "frontend",
          tech: ["Astro", "React", "TypeScript"],
        },
        {
          name: "API Layer",
          layer: "backend",
          tech: ["Serverless Functions", "Edge Runtime"],
        },
        {
          name: "Data Layer",
          layer: "data",
          tech: ["KV Store", "Edge Storage"],
        },
      ],
    },
  },
];
---

<div class="grid grid-cols-1 gap-8">
  {
    PROJECTS.map(({ name, description, url, githubUrl, imageUrl, architecture }) => (
      <article class="border border-white/10 rounded-lg overflow-hidden bg-white/[0.02] backdrop-blur-sm hover:border-white/20 transition-all duration-300">
        {/* Project image */}
        <div class="relative overflow-hidden h-64 sm:h-72 bg-gradient-to-br from-white/5 to-white/[0.02]">
          <img
            src={imageUrl}
            alt={`${name} screenshot`}
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
          />
        </div>

        <div class="p-6 space-y-4">
          {/* Header */}
          <div>
            <h3 class="text-2xl font-semibold text-white mb-2">{name}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{description}</p>
          </div>

          {/* Architecture diagram */}
          <div class="bg-white/[0.02] border border-white/5 rounded p-4 space-y-3">
            <h4 class="text-xs font-semibold text-gray-300 uppercase tracking-wider">Architecture</h4>
            <div class="space-y-2">
              {
                architecture.layers.map((layer) => (
                  <div class="flex items-center gap-2">
                    <div class="min-w-[100px] text-xs font-medium text-gray-300">
                      [{layer.name}]
                    </div>
                    <div class="text-gray-500 text-xs">→</div>
                    <div class="flex-1 flex flex-wrap gap-1">
                      {layer.tech.map((tech) => (
                        <LayerBadge name={tech} layer={layer.layer as 'frontend' | 'backend' | 'cloud' | 'data'} />
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          {/* Links */}
          <div class="flex flex-wrap gap-3 pt-2">
            <SocialPill href={url}>
              <LinkIcon class="size-4 lg:size-6" />
              Visit
            </SocialPill>
            <SocialPill href={githubUrl}>
              <GithubIcon class="size-4 lg:size-6" />
              Code
            </SocialPill>
          </div>
        </div>
      </article>
    ))
  }
</div>
