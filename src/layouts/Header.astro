---
import LanguageToggle from '../components/LanguageToggle.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<header class="sticky top-0 z-10 w-full">
  {/* Progress bar indicating scroll through layers */}
  <div
    class="h-1 bg-gradient-to-r from-blue-500 via-emerald-500 to-purple-500 opacity-0 hover:opacity-100 transition-opacity duration-300"
  >
  </div>

  <div
    class="flex justify-between items-center backdrop-blur-sm border-b border-white/5 px-3 md:px-6"
  >
    <nav
      class="flex flex-row text-center gap-x-4 sm:gap-x-6 py-4 text-nowrap text-xs sm:text-sm"
    >
      <a
        href="#resume"
        class="relative group text-gray-400 hover:text-white transition-colors duration-300 font-medium"
      >
        Resume
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-500 group-hover:w-full transition-all duration-300"
        ></span>
      </a>
      <a
        href="#experience"
        class="relative group text-gray-400 hover:text-white transition-colors duration-300 font-medium"
      >
        Experience
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-emerald-500 group-hover:w-full transition-all duration-300"
        ></span>
      </a>
      <a
        href="#projects"
        class="relative group text-gray-400 hover:text-white transition-colors duration-300 font-medium"
      >
        Projects
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-300"
        ></span>
      </a>
      <a
        href="#about-me"
        class="relative group text-gray-400 hover:text-white transition-colors duration-300 font-medium"
      >
        About
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-purple-500 group-hover:w-full transition-all duration-300"
        ></span>
      </a>
    </nav>

    {/* Theme and Language toggles */}
    <div class="flex gap-3 items-center">
      <LanguageToggle />
      <ThemeToggle class="hidden" />
    </div>
  </div>
</header>
