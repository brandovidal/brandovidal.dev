---
// Language toggle component with radio button style
---

<div
  id="language-toggle"
  class="font-mono text-xs border border-white/10 rounded bg-white/[0.02] backdrop-blur-sm flex divide-x divide-white/10 overflow-hidden"
>
  <button
    id="lang-es"
    class="px-3 py-1.5 transition-all duration-300"
    aria-label="Switch to Spanish"
  >
    ES
  </button>
  <button
    id="lang-en"
    class="px-3 py-1.5 transition-all duration-300"
    aria-label="Switch to English"
  >
    EN
  </button>
</div>

<script>
  import { initLanguage, setLanguage, getCurrentLanguage, onLanguageChange } from '../stores/langStore';
  import { translations } from '../i18n/translations';

  // Initialize language on page load
  initLanguage();

  // Update active state with emerald styling
  function updateActive() {
    const current = getCurrentLanguage();
    const esBtn = document.getElementById('lang-es');
    const enBtn = document.getElementById('lang-en');

    if (esBtn && enBtn) {
      if (current === 'es') {
        esBtn.className = 'px-3 py-1.5 bg-emerald-400 text-black font-semibold transition-all duration-300';
        enBtn.className = 'px-3 py-1.5 text-gray-400 hover:text-white transition-all duration-300';
      } else {
        enBtn.className = 'px-3 py-1.5 bg-emerald-400 text-black font-semibold transition-all duration-300';
        esBtn.className = 'px-3 py-1.5 text-gray-400 hover:text-white transition-all duration-300';
      }
    }

    // Update all translatable content dynamically
    updateAllTranslations(current);
  }

  // Update all translatable content on the page
  function updateAllTranslations(lang: 'es' | 'en') {
    const t = translations[lang];

    // Update nav links
    const navElements = document.querySelectorAll('[data-i18n-key]');
    navElements.forEach((el) => {
      const key = el.getAttribute('data-i18n-key');
      if (!key) return;

      const keys = key.split('.');
      let value: any = t;
      for (const k of keys) {
        value = value[k];
      }

      if (value && typeof value === 'string') {
        el.textContent = value;
      }
    });

    // Update section titles
    const resumeTitle = document.querySelector('[data-i18n-resume-title]');
    if (resumeTitle) {
      resumeTitle.textContent = lang === 'es' ? 'Resumen' : 'Resume';
    }

    const experienceTitle = document.querySelector('[data-i18n-experience-title]');
    if (experienceTitle) {
      experienceTitle.textContent = lang === 'es' ? 'Experiencia' : 'Experience';
    }

    const projectsTitle = document.querySelector('[data-i18n-projects-title]');
    if (projectsTitle) {
      projectsTitle.textContent = lang === 'es' ? 'Proyectos' : 'Projects';
    }

    const aboutTitle = document.querySelector('[data-i18n-about-title]');
    if (aboutTitle) {
      aboutTitle.textContent = lang === 'es' ? 'Sobre mí' : 'About';
    }
  }

  // Listen for language changes
  onLanguageChange(updateActive);

  // Handle clicks
  const esBtn = document.getElementById('lang-es');
  const enBtn = document.getElementById('lang-en');

  if (esBtn) {
    esBtn.addEventListener('click', () => setLanguage('es'));
  }
  if (enBtn) {
    enBtn.addEventListener('click', () => setLanguage('en'));
  }

  // Initial state
  updateActive();
</script>
