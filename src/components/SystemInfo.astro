---
interface Props {
  name: string;
  role: string;
  experience: string;
  availability: "available" | "unavailable";
  lang?: "es" | "en";
}

const { name, role, experience, availability } = Astro.props;

// Stack proficiency data
const stackProficiency = [
  { label: "Frontend", percentage: 95, color: "blue-400" },
  { label: "Backend", percentage: 90, color: "emerald-400" },
  { label: "Cloud", percentage: 85, color: "amber-400" },
  { label: "Data", percentage: 70, color: "purple-500" },
];
---

<div
  class="border border-white/10 rounded-lg bg-white/2 backdrop-blur-sm overflow-hidden mb-8"
>
  {/* Terminal header */}
  <div
    class="bg-linear-to-r from-blue-500/20 to-orange-500/20 border-b border-white/5 px-4 py-3 flex items-center gap-2"
  >
    <div class="flex gap-2">
      <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
      <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
      <div class="w-3 h-3 rounded-full bg-emerald-500/50"></div>
    </div>
    <span class="text-xs text-gray-400 ml-2">SYSTEM.USER</span>
  </div>

  {/* Terminal content - flex layout */}
  <div class="p-8 font-mono flex flex-col md:flex-row gap-8">
    {/* Left side: Gradient visualization (hidden on mobile) */}
    <div class="hidden md:flex shrink-0">
      <div
        class="w-32 h-32 rounded-lg bg-linear-to-br from-blue-400 via-emerald-400 via-amber-400 to-purple-500 opacity-20"
      >
      </div>
    </div>

    {/* Right side: System info labels */}
    <div class="flex-1 space-y-6">
      {/* User info section */}
      <div class="space-y-2">
        <div class="text-xs text-gray-400">
          <span class="text-emerald-400">$</span>
          <span class="ml-2">whoami</span>
        </div>
        <div class="pl-4 space-y-1">
          <div class="flex items-baseline gap-3">
            <span class="text-gray-500 text-xs min-w-20">user:</span>
            <span class="text-sm text-white">{name}</span>
          </div>
          <div class="flex items-baseline gap-3">
            <span class="text-gray-500 text-xs min-w-20">role:</span>
            <span class="text-xs text-gray-300">{role}</span>
          </div>
        </div>
      </div>

      {/* Divider */}
      <div class="border-t border-white/10"></div>

      {/* Stack proficiency */}
      <div class="space-y-3">
        <div class="text-xs text-gray-400">
          <span class="text-emerald-400">$</span>
          <span class="ml-2">stack --proficiency</span>
        </div>
        <div class="pl-4 space-y-2">
          {
            stackProficiency.map(({ label, percentage, color }) => (
              <div class="flex items-center gap-3">
                <span class="text-gray-500 text-xs min-w-16">{label}</span>
                <span
                  class="text-xs"
                  style={`color: var(--tw-${color.split("-")[0]}-${color.split("-")[1]})`}
                >
                  {percentage}%
                </span>
              </div>
            ))
          }
        </div>
      </div>

      {/* Divider */}
      <div class="border-t border-white/10"></div>

      {/* Experience and Status */}
      <div class="space-y-3">
        <div class="flex items-baseline gap-3">
          <span class="text-gray-500 text-xs min-w-20">uptime:</span>
          <span class="text-xs text-gray-300">{experience}</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-gray-500 text-xs min-w-20">status:</span>
          {
            availability === "available" ? (
              <span class="inline-flex items-center gap-2">
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
                <span class="text-xs text-emerald-400">● Available</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-2">
                <span class="inline-block w-2 h-2 rounded-full bg-gray-600" />
                <span class="text-xs text-gray-500">● Unavailable</span>
              </span>
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>
