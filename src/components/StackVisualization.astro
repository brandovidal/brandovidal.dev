---
import LayerBadge from './LayerBadge.astro';

interface StackItem {
  layer: 'frontend' | 'backend' | 'cloud' | 'data';
  label: string;
  technologies: string[];
  coverage: number; // percentage 0-100
}

interface Props {
  stacks: StackItem[];
}

const { stacks } = Astro.props;

const layerDisplay = {
  frontend: { label: 'Frontend', color: 'bg-blue-500' },
  backend: { label: 'Backend', color: 'bg-emerald-500' },
  cloud: { label: 'Cloud', color: 'bg-amber-500' },
  data: { label: 'Data', color: 'bg-purple-500' },
};
---

<div class="space-y-6">
  {
    stacks.map((stack) => (
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-gray-300">{layerDisplay[stack.layer].label}</span>
          <span class="text-xs text-gray-500">{stack.coverage}%</span>
        </div>
        <div class="w-full h-2 bg-white/5 rounded-full overflow-hidden border border-white/10">
          <div
            class={`h-full ${layerDisplay[stack.layer].color} rounded-full transition-all duration-300`}
            style={{ width: `${stack.coverage}%` }}
          />
        </div>
        <div class="flex flex-wrap gap-2">
          {stack.technologies.map((tech) => (
            <LayerBadge name={tech} layer={stack.layer} />
          ))}
        </div>
      </div>
    ))
  }
</div>
