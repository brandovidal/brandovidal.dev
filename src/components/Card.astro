---
interface Props {
  class?: string;
  style?: string;
  hover?: boolean;
}

const { class: className = '', style = '', hover = true } = Astro.props;
---

<div
  style={style}
  class={`
    border border-purple-500/10 rounded-lg
    bg-white/[0.02] backdrop-blur-sm
    shadow-[0_8px_16px_-6px_rgba(0,0,0,0.4),0_0_1px_rgba(139,92,246,0.3)]
    ${hover ? 'hover:border-purple-500/30 hover:bg-white/[0.04] hover:shadow-[0_12px_24px_-8px_rgba(0,0,0,0.5),0_0_20px_rgba(139,92,246,0.2)] transition-all duration-300' : ''}
    ${className}
  `}
>
  <slot />
</div>
