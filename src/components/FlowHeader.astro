---
interface Props {
  name: string;
  role: string;
  lang?: 'es' | 'en';
}

const { name, role } = Astro.props;

const layers = [
  { label: 'FE', color: 'blue', fullName: 'Frontend' },
  { label: 'BE', color: 'emerald', fullName: 'Backend' },
  { label: 'CL', color: 'amber', fullName: 'Cloud' },
  { label: 'DT', color: 'purple', fullName: 'Data' },
];

const layerColorMap = {
  blue: 'bg-blue-500/20 border-blue-500/30 text-blue-400',
  emerald: 'bg-emerald-500/20 border-emerald-500/30 text-emerald-400',
  amber: 'bg-amber-500/20 border-amber-500/30 text-amber-400',
  purple: 'bg-purple-500/20 border-purple-500/30 text-purple-400',
};
---

<div class="w-full">
  {/* Desktop: Horizontal flow layout */}
  <div class="hidden md:flex items-center justify-center gap-4 lg:gap-6 py-8">
    {/* Input Node (Name) */}
    <div class="flex flex-col items-center gap-2">
      <span class="text-xs text-gray-500 uppercase tracking-wider">Input</span>
      <div class="border border-white/10 rounded-lg bg-white/[0.02] backdrop-blur-sm px-4 py-3 min-w-max">
        <span class="text-xl lg:text-2xl font-bold text-white">{name}</span>
      </div>
    </div>

    {/* Flow line and layer nodes */}
    {layers.map((layer, index) => (
      <div class="flex items-center gap-4 lg:gap-6">
        {/* Connecting line with gradient animation */}
        <div class="hidden lg:flex items-center flex-shrink-0 h-px w-12 relative">
          <div
            class="absolute inset-0 bg-gradient-to-r opacity-40 animate-[flow_3s_ease-in-out_infinite]"
            style={`background-image: linear-gradient(90deg, var(--tw-gradient-stops)); --tw-gradient-from: transparent; --tw-gradient-to: transparent;`}
          >
          </div>
          <svg class="absolute inset-0 w-full h-full" viewBox="0 0 48 1" preserveAspectRatio="none">
            <line
              x1="0"
              y1="0.5"
              x2="48"
              y2="0.5"
              stroke="currentColor"
              stroke-width="0.5"
              class="opacity-30 text-gray-600"
            />
          </svg>
        </div>

        {/* Layer node */}
        <div class="flex flex-col items-center gap-2 group">
          <span
            class="text-xs text-gray-500 uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity"
          >
            {layer.fullName}
          </span>
          <div
            class={`w-12 h-12 lg:w-14 lg:h-14 rounded-lg border flex items-center justify-center font-mono font-semibold text-sm animate-[glow_2s_ease-in-out_infinite] ${layerColorMap[layer.color as keyof typeof layerColorMap]}`}
            style={`animation-delay: ${index * 0.3}s;`}
          >
            {layer.label}
          </div>
        </div>
      </div>
    ))}

    {/* Connecting line to output */}
    <div class="hidden lg:flex items-center flex-shrink-0 h-px w-12 relative">
      <svg class="absolute inset-0 w-full h-full" viewBox="0 0 48 1" preserveAspectRatio="none">
        <line
          x1="0"
          y1="0.5"
          x2="48"
          y2="0.5"
          stroke="currentColor"
          stroke-width="0.5"
          class="opacity-30 text-gray-600"
        />
      </svg>
    </div>

    {/* Output Node (Role) */}
    <div class="flex flex-col items-center gap-2">
      <span class="text-xs text-gray-500 uppercase tracking-wider">Output</span>
      <div class="border border-white/10 rounded-lg bg-white/[0.02] backdrop-blur-sm px-4 py-3 min-w-max">
        <span class="text-sm lg:text-base text-gray-300">{role}</span>
      </div>
    </div>
  </div>

  {/* Mobile: Vertical stack layout */}
  <div class="md:hidden flex flex-col items-center gap-6 py-8">
    {/* Input Node (Name) */}
    <div class="flex flex-col items-center gap-2">
      <span class="text-xs text-gray-500 uppercase tracking-wider">Input</span>
      <div class="border border-white/10 rounded-lg bg-white/[0.02] backdrop-blur-sm px-4 py-3">
        <span class="text-lg font-bold text-white">{name}</span>
      </div>
    </div>

    {/* Vertical connector */}
    <div class="h-4 w-px bg-gradient-to-b from-transparent via-gray-500 to-transparent opacity-30"></div>

    {/* Layer nodes in vertical stack */}
    <div class="flex flex-col items-center gap-4">
      {layers.map((layer, index) => (
        <div class="flex flex-col items-center gap-2">
          <div
            class={`w-12 h-12 rounded-lg border flex items-center justify-center font-mono font-semibold text-sm animate-[glow_2s_ease-in-out_infinite] ${layerColorMap[layer.color as keyof typeof layerColorMap]}`}
            style={`animation-delay: ${index * 0.3}s;`}
          >
            {layer.label}
          </div>
          {index < layers.length - 1 && (
            <div class="h-4 w-px bg-gradient-to-b from-transparent via-gray-500 to-transparent opacity-30"></div>
          )}
        </div>
      ))}
    </div>

    {/* Vertical connector */}
    <div class="h-4 w-px bg-gradient-to-b from-transparent via-gray-500 to-transparent opacity-30"></div>

    {/* Output Node (Role) */}
    <div class="flex flex-col items-center gap-2">
      <span class="text-xs text-gray-500 uppercase tracking-wider">Output</span>
      <div class="border border-white/10 rounded-lg bg-white/[0.02] backdrop-blur-sm px-4 py-3">
        <span class="text-sm text-gray-300">{role}</span>
      </div>
    </div>
  </div>
</div>
